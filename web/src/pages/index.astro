---
import { getEntry } from "astro:content";
import { CVPage } from "../components/CVPage";
import Header from "../components/Header.astro";
import "../styles/global.css";

const cv = await getEntry("cv", "cv.it");
if (!cv) throw new Error("cv.it.yaml not found");
const data = cv.data;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pdfUrl = `${base}cv_it.pdf`;

const pageUrl = new URL(`${base}`, Astro.site).href;
const gh = data.person.links.github;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: data.person.name,
  jobTitle: data.person.title,
  url: pageUrl,
  address: { "@type": "PostalAddress", addressLocality: data.person.location },
  worksFor: { "@type": "Organization", name: data.experience[0]?.company },
  alumniOf: [...new Set(data.education.map((e) => e.institution))].map((name) => ({
    "@type": "CollegeOrUniversity",
    name,
  })),
  knowsAbout: [...data.skills.domains, ...Object.values(data.skills.technologies).flat()],
  sameAs: [
    `https://www.linkedin.com/in/${data.person.links.linkedin}`,
    ...(gh && !gh.startsWith("<") ? [`https://github.com/${gh}`] : []),
  ],
};

const labels = {
  filterLabels: { hybrid: "Entrambi", leadership: "Leadership", engineering: "Engineering" },
  sectionExperience: "Esperienza",
  sectionSkills: "Competenze",
  sectionDomains: "Domini",
  sectionEducation: "Formazione",
  sectionProjects: "Progetti",
  sectionLanguages: "Lingue",
  sectionBeyond: "Beyond Work",
  thesis: "Tesi",
  downloadPdf: "Scarica PDF",
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{data.person.name} — CV</title>
    <meta name="description" content={`CV di ${data.person.name} — ${data.person.title}`} />
    <meta property="og:title" content={`${data.person.name} — CV`} />
    <meta property="og:description" content={`CV di ${data.person.name} — ${data.person.title}`} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="alternate" hreflang="it" href={`${base}`} />
    <link rel="alternate" hreflang="en" href={`${base}en/`} />
    <link rel="canonical" href={`${base}`} />
  </head>
  <body>
    <Header lang="it" name={data.person.name} />
    <main>
      <CVPage client:load data={data} pdfUrl={pdfUrl} labels={labels} />
    </main>
    <footer>
      <div class="container footer-inner">
        <span>Aggiornato {data.meta.updated}</span>
        <a href={`${base}en/`}>English version →</a>
      </div>
    </footer>
  </body>
</html>
